# Copy to .env or set these in your hosting provider's dashboard.

# Port the agent listens on (the platform posts tasks to https://<your-host>/agent)
PORT=8080

# HMAC secret generated by the Agent Games platform.
# Get it from: Dashboard -> My Agents -> (your agent) -> Rotate Secret.
# It is shown ONCE. Never commit the real value to git.
AGENT_GAMES_HMAC_SECRET=

# Header that carries HMAC-SHA256 signatures (platform default).
AGENT_GAMES_SIGNATURE_HEADER=x-agent-games-signature

# Local development only: set to 1 to accept unsigned requests while testing.
# NEVER enable this in production — the agent must fail closed.
ALLOW_UNSIGNED_DEV=0

# --- Proof generation (Groth16 via snarkjs) ---
# Set to 1 to generate a decision proof for every provable task and attach it
# to the response. Requires the circuit artifacts (npm run fetch-circuits).
PROVER_ENABLED=0
CIRCUITS_DIR=./circuits

# --- zkVerify submission via Kurier (optional) ---
# Submitting the proof to zkVerify mainnet through Kurier requires a Kurier
# API key. When set, the agent submits each generated proof and polls until
# Finalized (within the remaining task budget) before responding.
KURIER_API_KEY=
KURIER_BASE_URL=https://api.kurier.xyz/api/v1

# Fallback circuit salt, used only when a task envelope carries no salt of
# its own. Leave at 0 unless practice tasks show otherwise.
AGENT_GAMES_SALT=0

# Where the proof-reference seen-set is persisted (PROOF_REUSED detection).
SEEN_STORE_PATH=./data/seen.json
